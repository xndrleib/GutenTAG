[flake8]
show-source = True
max-complexity = 10
hang-closing = False
max-line-length = 88
extend-select =
    B950

extend-ignore =
    C901
    E203
    E402
    E501

extend-exclude =
    .git
    __pycache__
    .mypy_cache
    .pytest_cache
    .venv
    build
    dist
    doc
    *.egg-info

per-file-ignores =
    __init__.py: F401
    gutenTAG/api/*: F401
